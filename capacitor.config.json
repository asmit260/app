{
  "appId": "com.anitrack.app",
  "appName": "AniTrack",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#F4EFE6"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#F4EFE6",
      "showSpinner": false
    }
  }
}
